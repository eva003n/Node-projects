<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- <link rel="stylesheet" href="styles.css"> -->
    <!-- <link rel="stylesheet" href="../styles.css" /> -->

    <title>Authentication | <%= signUp ? "Sign up": "Sign in" %></title>
  </head>
  <body>
        <header style="display: flex; justify-content: space-evenly; padding: 1rem;">
      <p style="font-weight: 700;">Personal blog</p>

      <nav>
        <ul style="display: flex; gap: 1rem;">
          <li>
            <a href="/">
              Guest
            </a>
          </li>
          <li>
            <a href="/admin">
            Admin
            </a>
          </li>
        </ul>
      </nav>
    </header>
    <section style="display: grid; gap: 1rem; place-content: center">
      <h2><%= signUp ? "Sign up": "Sign in" %></h2>
      <form
        action="<%= signUp? '/api/v1/auth/sign-up' : '/api/v1/auth/sign-in' %>"
        method="post"
        style="display: flex; gap: 1rem; flex-direction: column; font: inherit;"
      >
        <!-- conditionaly render username based on where this is sign up of sign in page -->

        <div style="display: grid; gap: 0.5rem">
          <label for="username">Username</label>
          <input
            id="username"
            type="text"
            name="username"
            style="width: 100%; padding: 8px 16px; border-radius: 10px"
          />
        </div>

        <div style="display: grid; gap: 0.5rem">
          <label for="password">Password</label>
          <input
            id="password"
            type="password"
            name="password"
            style="width: 100%; padding: 8px 16px; border-radius: 10px"
          />
        </div>
        <div  style="display: flex; ">
          <button
            type="submit"
            style=" padding: 8px 16px; border-radius: 10px"
          >
            <%= signUp ? "Sign up": "Sign in" %>
          </button>
        </div>
      </form>

      <div>
        <p>
          <%= signUp? "Already have an account " : "Dont have an account " %>
          <a
            href="<%= signUp? '/api/v1/auth/sign-in' : '/api/v1/auth/sign-up' %>"
          >
            <%= signUp ? "Sign in": "Sign up" %>
          </a>
        </p>
      </div>

    
    </section>
  </body>
</html>
